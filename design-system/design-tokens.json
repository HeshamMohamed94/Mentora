{
  "$schema": "Mentora Design Tokens v1.3 — platform-independent source of truth. Three-layer architecture: primitive -> semantic -> component. Product code must consume 'semantic' or 'component' tokens only; never 'primitive' values directly. See DESIGN_SYSTEM.md § Token Architecture and § Naming Convention.",
  "meta": {
    "product": "Mentora",
    "tagline": "Learn. Build. Grow.",
    "version": "1.3.2",
    "direction": "Material 3 Expressive-inspired, modern SaaS, educational, clean, professional, minimal, friendly",
    "lastUpdated": "2026-09-04",
    "changelog": "./CHANGELOG.md",
    "namingConvention": "{category}.{concept}.{property}.{variant?}.{state?}, lowerCamelCase segments, dot-separated. See DESIGN_SYSTEM.md § Naming Convention.",
    "tokenLayers": {
      "1_primitive": "Raw, context-free values (color.primitive.*). Never referenced directly by product code.",
      "2_semantic": "Purpose-named tokens that resolve per theme (color.semantic.{light,dark}.*, typography.scale.*, spacing.scale.*, shape.radius.*, elevation.*, border.*, motion.*, icon.*). This is the default consumption layer.",
      "3_component": "Component-scoped aliases of semantic tokens (component.*), e.g. component.button.primary.background.default -> color.brand.primary. Use when a component needs a name stable against future semantic re-mapping."
    }
  },

  "units": {
    "note": "Units are mapped SEMANTICALLY across platforms, not physically identical. A token's numeric value is the same integer on all three platforms, but the platform unit it is expressed in behaves differently: web px does not auto-scale with the OS text-size setting unless converted to rem for type; Android sp scales with the user's font-size setting while dp does not; iOS pt scales with Dynamic Type for text via the system font APIs but is fixed for layout metrics unless explicitly made Dynamic-Type-aware. Always use the 'text' unit column for typography tokens and the 'layout' unit column for spacing/radius/icon/elevation tokens.",
    "web": { "text": "rem (1rem = 16px root; token px value / 16 = rem)", "layout": "px" },
    "android": { "text": "sp (scales with system font size)", "layout": "dp (density-independent, does not scale with font size)" },
    "ios": { "text": "pt via Dynamic Type-aware Font/UIFont APIs (scales with Text Size / Larger Accessibility Sizes settings)", "layout": "pt (fixed unless explicitly wrapped in a Dynamic Type-relative metric)" },
    "rule": "Typography tokens MUST use the scaling unit (rem/sp/Dynamic-Type pt) on every platform so browser zoom, Android font scaling, and iOS Dynamic Type all work. Spacing, radius, elevation, icon, and border-width tokens use the fixed layout unit (px/dp/pt) and do not scale with text size."
  },

