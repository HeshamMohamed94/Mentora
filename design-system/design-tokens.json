  "typography": {
    "$description": "v1.3: fontFamily now carries both scripts explicitly -- English/Latin content uses *.latin (unchanged from v1.0-v1.2, still just called 'web'/'android'/'ios' for backward reference), Arabic content uses *.arabic. A text run's detected/tagged script selects which family applies; the size/lineHeight/weight/letterSpacing values in 'scale' below are shared by both and do not change per script, except the documented 'arabicAdjustments' overrides. See LOCALIZATION.md § 4.",
    "fontFamily": {
      "web": "Inter, -apple-system, 'Segoe UI', sans-serif",
      "webArabic": "'IBM Plex Sans Arabic', 'Noto Sans Arabic', sans-serif",
      "android": "Roboto",
      "androidArabic": "'Noto Sans Arabic', sans-serif",
      "ios": "SF Pro",
      "iosArabic": "SF Arabic"
    },
    "arabicAdjustments": {
      "note": "Applied only to text runs detected/tagged as Arabic script, on top of the shared 'scale' values below -- never a separate type scale. See LOCALIZATION.md § 4.",
      "letterSpacing": 0,
      "bodyLineHeightMultiplier": 1.1
    },
    "fontWeight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "display.large":  { "fontSize": 48, "lineHeight": 56, "fontWeight": 700, "letterSpacing": -0.25 },
      "display.medium": { "fontSize": 40, "lineHeight": 48, "fontWeight": 700, "letterSpacing": -0.25 },
      "heading.h1":      { "fontSize": 32, "lineHeight": 40, "fontWeight": 700, "letterSpacing": 0 },
      "heading.h2":      { "fontSize": 28, "lineHeight": 36, "fontWeight": 700, "letterSpacing": 0 },
      "heading.h3":      { "fontSize": 24, "lineHeight": 32, "fontWeight": 600, "letterSpacing": 0 },
      "heading.h4":      { "fontSize": 20, "lineHeight": 28, "fontWeight": 600, "letterSpacing": 0.15 },
      "body.large":      { "fontSize": 18, "lineHeight": 28, "fontWeight": 400, "letterSpacing": 0.15 },
      "body.medium":     { "fontSize": 16, "lineHeight": 24, "fontWeight": 400, "letterSpacing": 0.25 },
      "body.small":      { "fontSize": 14, "lineHeight": 20, "fontWeight": 400, "letterSpacing": 0.25 },
      "label.large":     { "fontSize": 14, "lineHeight": 20, "fontWeight": 600, "letterSpacing": 0.1 },
      "label.medium":    { "fontSize": 12, "lineHeight": 16, "fontWeight": 600, "letterSpacing": 0.5 },
      "caption":         { "fontSize": 12, "lineHeight": 16, "fontWeight": 400, "letterSpacing": 0.4 }
    },
    "responsive": {
      "note": "Only display.* and heading.h1/h2 scale down below desktop, so hero/page titles don't overwhelm narrow viewports. heading.h3/h4, body.*, label.*, and caption are constant across all breakpoints — they are already sized for compact contexts. Values are fontSize/lineHeight in px (or platform-equivalent scaling unit per the 'units' section).",
      "display.large":  { "mobile": { "fontSize": 34, "lineHeight": 40 }, "tablet": { "fontSize": 40, "lineHeight": 48 }, "desktop": { "fontSize": 48, "lineHeight": 56 }, "largeDesktop": { "fontSize": 48, "lineHeight": 56 } },
      "display.medium": { "mobile": { "fontSize": 30, "lineHeight": 36 }, "tablet": { "fontSize": 34, "lineHeight": 40 }, "desktop": { "fontSize": 40, "lineHeight": 48 }, "largeDesktop": { "fontSize": 40, "lineHeight": 48 } },
      "heading.h1":      { "mobile": { "fontSize": 26, "lineHeight": 33 }, "tablet": { "fontSize": 28, "lineHeight": 36 }, "desktop": { "fontSize": 32, "lineHeight": 40 }, "largeDesktop": { "fontSize": 32, "lineHeight": 40 } },
      "heading.h2":      { "mobile": { "fontSize": 23, "lineHeight": 29 }, "tablet": { "fontSize": 25, "lineHeight": 32 }, "desktop": { "fontSize": 28, "lineHeight": 36 }, "largeDesktop": { "fontSize": 28, "lineHeight": 36 } }
    }
  },

  "spacing": {
    "baseUnit": 4,
    "scale": {
      "space.0": 0, "space.1": 4, "space.2": 8, "space.3": 12, "space.4": 16,
      "space.5": 20, "space.6": 24, "space.8": 32, "space.10": 40, "space.12": 48, "space.16": 64
    },
    "pagePadding": { "mobile": 16, "tablet": 24, "desktop": 32, "largeDesktop": 48 },
    "usage": {
      "cardPadding": "space.4 (16)",
      "sectionSpacing": "space.10 (40) mobile / space.12 (48) desktop",
      "listGap": "space.2 (8) compact / space.3 (12) default",
      "gridGap": "space.4 (16) mobile / space.6 (24) desktop",
      "componentInternalGap": "space.2 (8) / space.3 (12)"
    }
  },

  "shape": {
    "radius": { "none": 0, "small": 8, "medium": 12, "large": 16, "xlarge": 24, "full": 999 },
    "componentUsage": {
      "button": "radius.medium (12)",
      "input": "radius.medium (12)",
      "courseCard": "radius.large (16)",
      "dashboardCard": "radius.large (16)",
      "modal": "radius.xlarge (24)",
      "bottomSheet": "radius.xlarge (24) top corners only",
      "chip": "radius.full (999)",
      "avatar": "radius.full (999)",
      "snackbar": "radius.medium (12)",
      "checkoutSummary": "radius.large (16)",
      "successState": "n/a (no container shape)",
      "toggle": "radius.full (999)",
      "fileUpload": "radius.medium (12)",
      "dataTableCollapsedCard": "radius.medium (12)",
      "select": "radius.medium (12) -- field; menu also radius.medium (12)"
    }
  },

  "elevation": {
    "0": { "web": "none", "compose_dp": 0, "ios": { "radius": 0, "y": 0, "opacity": 0 }, "usage": "flat, resting elements using border only" },
    "1": { "web": "0 1px 2px rgba(17,18,23,0.06)", "compose_dp": 1, "ios": { "radius": 2, "y": 1, "opacity": 0.06 }, "usage": "resting cards" },
    "2": { "web": "0 2px 8px rgba(17,18,23,0.08)", "compose_dp": 3, "ios": { "radius": 6, "y": 2, "opacity": 0.08 }, "usage": "hovered/raised cards, dropdown triggers" },
    "3": { "web": "0 4px 16px rgba(17,18,23,0.10)", "compose_dp": 6, "ios": { "radius": 12, "y": 4, "opacity": 0.10 }, "usage": "menus, popovers, tooltips" },
    "4": { "web": "0 8px 24px rgba(17,18,23,0.12)", "compose_dp": 12, "ios": { "radius": 20, "y": 8, "opacity": 0.12 }, "usage": "modals, dialogs, bottom sheets" },
    "darkModeNote": "Dark surfaces prefer a lighter surface tone (surface.elevated) over heavier shadow. Shadow color stays black; reduce opacity ~30% relative to light values since dark backgrounds already read as elevated via tone. Elevation is resolved through the same semantic surface/elevation tokens in both themes -- components never branch on theme to decide shadow strength, the token value already differs per theme."
  },

  "border": {
    "width": { "default": 1, "focus": 2 },
    "colorTokenRefs": {
      "default": "color.border.default",
      "strong": "color.border.strong",
      "focus": "color.border.focus",
      "error": "color.border.error"
    }
  },

  "motion": {
    "duration": { "fast": 150, "normal": 200, "slow": 300 },
    "easing": {
      "standard": "cubic-bezier(0.4, 0.0, 0.2, 1)",
      "decelerate": "cubic-bezier(0.0, 0.0, 0.2, 1)",
      "accelerate": "cubic-bezier(0.4, 0.0, 1, 1)"
    },
    "usage": {
      "buttonFeedback": "duration.fast + easing.standard",
      "dialogOpen": "duration.normal + easing.decelerate",
      "dialogClose": "duration.fast + easing.accelerate",
      "bottomSheetOpen": "duration.normal + easing.decelerate",
      "bottomSheetClose": "duration.fast + easing.accelerate",
      "navigationTransition": "duration.slow + easing.standard",
      "pageTransition": "duration.slow + easing.standard",
      "progressAnimation": "duration.normal + easing.standard, linear for indeterminate loops"
    },
    "principle": "Motion communicates state change, never decoration. No bounce, spring overshoot, or parallax without a functional reason.",
    "reducedMotion": "When the platform's reduced-motion preference is on, translate/scale/slide transitions are replaced by an opacity cross-fade at duration.fast, or an instant cut for sub-100ms feedback. See ACCESSIBILITY.md § Motion & Reduced Motion."
  },

  "icon": {
    "family": "Material Symbols Rounded",
    "sizes": { "small": 16, "medium": 20, "default": 24, "large": 32 },
    "defaultWeight": 400,
    "defaultOpticalSize": 24,
    "directional": {
      "note": "Icons that encode a left/right direction MUST be authored as logical (start/end) and mirrored automatically in RTL locales (see LOCALIZATION.md). Icons with no inherent direction never mirror.",
      "mirrorInRtl": ["chevron_left", "chevron_right", "arrow_back", "arrow_forward", "arrow_back_ios", "arrow_forward_ios", "trending_flat", "redo", "undo", "reply", "forward", "last_page", "first_page", "double_arrow", "menu_open"],
      "neverMirror": ["play_arrow", "pause", "check", "check_circle", "cancel", "close", "search", "add", "remove", "star", "favorite", "download", "upload", "expand_more", "expand_less", "refresh", "visibility", "visibility_off", "volume_up", "volume_off", "fullscreen", "fullscreen_exit", "speed", "cloud_upload", "insert_drive_file", "drag_indicator", "arrow_upward", "arrow_downward", "more_vert"]
    }
  },

  "breakpoints": {
    "mobile": { "min": 0, "max": 599 },
    "tablet": { "min": 600, "max": 1023 },
    "desktop": { "min": 1024, "max": 1439 },
    "largeDesktop": { "min": 1440, "max": null }
  },

  "grid": {
    "columns": { "mobile": 4, "tablet": 8, "desktop": 12, "largeDesktop": 12 },
    "gutter": { "mobile": 16, "tablet": 24, "desktop": 24, "largeDesktop": 24 },
    "maxContentWidth": 1440,
    "preferredMarketingWidth": "1200-1280"
  },

  "courseGrid": {
    "mobile": 1, "tablet": 2, "desktop": 3, "largeDesktop": 4
  },

  "avatar": {
    "small": 24, "medium": 40, "large": 64, "xlarge": 96
  },

  "touchTarget": {
    "android_dp": 48,
    "ios_pt": 44,
    "web_px": 44
  },

  "component": {
    "$description": "Layer 3 of the token architecture. Every value here is an ALIAS (curly-brace path) into color.semantic.*, typography.scale.*, spacing.scale.*, shape.radius.*, elevation.*, border.*, or state.* -- never a literal value. Aliases are theme-agnostic: {color.brand.primary} resolves against whichever theme (light/dark) is active. This is the layer COMPONENTS.md documents in prose; this object is its machine-readable equivalent, generated into per-platform theme objects (see platform-mapping.md).",
    "button": {
      "primary": {
        "height": 48, "radius": "{shape.radius.medium}", "paddingX": "{spacing.scale.space.6}", "typography": "{typography.scale.label.large}",
        "background": { "default": "{color.brand.primary}", "hover": "{color.brand.primaryHover}", "pressed": "{color.brand.primaryPressed}", "focused": "{color.brand.primary}", "disabled": "{color.surface.default}+{color.brand.primary}@{state.disabledContainerOpacity}" },
        "text": { "default": "{color.brand.onPrimary}", "disabled": "{color.text.disabled}" }
      },
      "secondary": {
        "height": 48, "radius": "{shape.radius.medium}", "paddingX": "{spacing.scale.space.6}", "typography": "{typography.scale.label.large}",
        "border": { "default": "{color.brand.primary}", "focused": "{color.border.focus}", "disabled": "{color.border.default}" },
        "background": { "default": "transparent", "hover": "{color.brand.primary}@{state.hoverOpacity}", "pressed": "{color.brand.primary}@{state.pressedOpacity}" },
        "text": { "default": "{color.brand.primary}", "disabled": "{color.text.disabled}" }
      },
      "tonal": {
        "height": 48, "radius": "{shape.radius.medium}", "paddingX": "{spacing.scale.space.6}", "typography": "{typography.scale.label.large}",
        "background": { "default": "{color.brand.primaryContainer}", "hover": "{color.brand.primaryContainer}+{color.brand.onPrimaryContainer}@{state.hoverOpacity}", "pressed": "{color.brand.primaryContainer}+{color.brand.onPrimaryContainer}@{state.pressedOpacity}", "disabled": "{color.surface.variant}" },
        "text": { "default": "{color.brand.onPrimaryContainer}", "disabled": "{color.text.disabled}" }
      },
      "text": {
        "height": 40, "radius": "{shape.radius.medium}", "paddingX": "{spacing.scale.space.3}", "typography": "{typography.scale.label.large}",
        "background": { "default": "transparent", "hover": "{color.brand.primary}@{state.hoverOpacity}", "pressed": "{color.brand.primary}@{state.pressedOpacity}" },
        "text": { "default": "{color.brand.primary}", "disabled": "{color.text.disabled}" }
      },
      "icon": {
        "size": 40, "radius": "{shape.radius.full}", "iconSize": "{icon.default}",
        "icon": { "default": "{color.text.secondary}", "hover": "{color.text.primary}", "pressed": "{color.text.primary}", "disabled": "{color.text.disabled}" }
      }
    },
    "input": {
      "height": 52, "radius": "{shape.radius.medium}", "paddingX": "{spacing.scale.space.4}", "paddingY": "{spacing.scale.space.3}",
      "typography": "{typography.scale.body.medium}", "labelTypography": "{typography.scale.label.medium}", "helperTypography": "{typography.scale.caption}",
      "border": { "default": "{color.border.default}", "hover": "{color.border.strong}", "focused": "{color.border.focus}", "error": "{color.border.error}", "success": "{color.success.default}", "disabled": "{color.border.default}" },
      "background": { "default": "{color.surface.default}", "disabled": "{color.surface.variant}" },
      "text": { "default": "{color.text.primary}", "placeholder": "{color.text.disabled}", "disabled": "{color.text.disabled}", "error": "{color.error.default}" }
    },
    "card": {
      "radius": "{shape.radius.large}", "padding": "{spacing.scale.space.4}",
      "background": "{color.surface.default}", "border": "{color.border.default}",
      "elevation": { "default": "{elevation.1}", "hover": "{elevation.2}" }
    },
    "chip": {
      "height": 28, "radius": "{shape.radius.full}", "paddingX": "{spacing.scale.space.3}", "typography": "{typography.scale.label.medium}",
      "background": { "default": "{color.surface.variant}", "selected": "{color.brand.primaryContainer}", "onImage": "{color.overlay.chipScrim}", "disabled": "{color.surface.variant}" },
      "text": { "default": "{color.text.secondary}", "selected": "{color.brand.onPrimaryContainer}", "onImage": "{color.text.inverse}", "disabled": "{color.text.disabled}" }
    },
    "badge": {
      "height": 20, "radius": "{shape.radius.full}", "paddingX": "{spacing.scale.space.2}", "typography": "{typography.scale.label.medium}",
      "neutral": { "background": "{color.surface.variant}", "text": "{color.text.secondary}" },
      "success": { "background": "{color.success.container}", "text": "{color.success.onSuccessContainer}" },
      "warning": { "background": "{color.warning.container}", "text": "{color.warning.onWarningContainer}" },
      "error": { "background": "{color.error.container}", "text": "{color.error.onErrorContainer}" },
      "info": { "background": "{color.info.container}", "text": "{color.info.onInfoContainer}" },
      "brand": { "background": "{color.brand.primaryContainer}", "text": "{color.brand.onPrimaryContainer}" }
    },
    "progressBar": {
      "height": 8, "radius": "{shape.radius.full}",
      "track": "{color.surface.variant}",
      "fill": { "default": "{color.brand.primary}", "complete": "{color.success.default}", "paused": "{color.text.disabled}" }
    },
    "snackbar": {
      "radius": "{shape.radius.medium}", "paddingX": "{spacing.scale.space.4}", "paddingY": "{spacing.scale.space.3}", "typography": "{typography.scale.body.small}",
      "background": "{color.surface.inverse}", "text": "{color.text.inverse}", "action": "{color.brand.onSurfaceInverse}", "elevation": "{elevation.3}"
    },
    "navItem": {
      "height": 44, "paddingX": "{spacing.scale.space.4}", "typography": "{typography.scale.label.large}",
      "icon": "{icon.default}",
      "background": { "default": "transparent", "hover": "{color.text.primary}@{state.hoverOpacity}", "active": "{color.brand.primaryContainer}" },
      "text": { "default": "{color.text.secondary}", "hover": "{color.text.primary}", "active": "{color.brand.onPrimaryContainer}" }
    },
    "videoPlayer": {
      "$description": "v1.2. Control-surface contract only -- no streaming/playback implementation. The control bar always renders on top of arbitrary video pixels, in BOTH themes, so every glyph/track token below is deliberately theme-invariant (color.overlay.scrim is already dark in both themes; color.text.inverse is legible on it in both themes). The scrubber/timeline direction is always LTR regardless of app layout direction -- see LOCALIZATION.md § 3.",
      "aspectRatio": "16:9",
      "controlBar": { "background": "{color.overlay.scrim}", "paddingX": "{spacing.scale.space.3}", "paddingY": "{spacing.scale.space.2}" },
      "controlButton": {
        "touchTarget": "{touchTarget.web_px}", "iconSize": "{icon.default}",
        "icon": { "default": "{color.text.inverse}", "disabled": "{color.text.inverse}@{state.disabledContentOpacity}" },
        "background": { "default": "transparent", "hover": "{color.text.inverse}@{state.hoverOpacity}", "pressed": "{color.text.inverse}@{state.pressedOpacity}" }
      },
      "scrubber": {
        "direction": "ltr-always",
        "trackHeightDefault": "{spacing.scale.space.1}", "trackHeightActive": "{component.progressBar.height}",
        "radius": "{shape.radius.full}",
        "track": "{color.text.inverse}@{state.hoverOpacity}",
        "buffered": "{color.text.inverse}@{state.pressedOpacity}",
        "fill": "{color.brand.primary}",
        "thumbSize": "{spacing.scale.space.3}", "thumbSizeActive": "{spacing.scale.space.4}",
        "thumbColor": "{color.brand.primary}"
      },
      "timeLabel": { "typography": "{typography.scale.caption}", "color": "{color.text.inverse}" },
      "speedControl": { "typography": "{typography.scale.label.medium}", "text": "{color.text.inverse}", "menuElevation": "{elevation.3}", "menuBackground": "{color.surface.elevated}", "menuText": "{color.text.primary}" },
      "lessonProgress": "component.progressBar"
    },
    "checkout": {
      "$description": "v1.2. Order-summary/confirmation shell for Mentora's simulated Demo Payment flow only -- see ../product/DEMO_PAYMENT_FLOW.md. MUST NEVER contain card/CVV/expiry/billing-address/bank fields; the field set below is exhaustive and closed.",
      "radius": "{shape.radius.large}", "padding": "{spacing.scale.space.5}",
      "background": "{color.surface.default}", "border": "{color.border.default}",
      "lineItem": { "typography": "{typography.scale.body.medium}", "color": "{color.text.primary}" },
      "priceLabel": { "typography": "{typography.scale.body.medium}", "color": "{color.text.secondary}" },
      "priceTotal": { "typography": "{typography.scale.heading.h3}", "color": "{color.text.primary}" },
      "demoNotice": { "background": "{color.info.container}", "text": "{color.info.onInfoContainer}", "radius": "{shape.radius.medium}", "paddingX": "{spacing.scale.space.3}", "paddingY": "{spacing.scale.space.2}", "typography": "{typography.scale.body.small}" },
      "confirmAction": "component.button.primary",
      "cancelAction": "component.button.text"
    },
    "successState": {
      "$description": "v1.2. Sibling of emptyState/errorState/loadingState (see COMPONENTS.md § State Patterns) for a celebratory confirmation moment, e.g. Demo Purchase success.",
      "icon": { "size": "{icon.large}", "color": "{color.success.default}" },
      "title": { "typography": "{typography.scale.heading.h3}", "color": "{color.text.primary}" },
      "description": { "typography": "{typography.scale.body.small}", "color": "{color.text.secondary}" },
      "primaryAction": "component.button.primary",
      "containerPaddingY": "{spacing.scale.space.10}",
      "motion": { "duration": "{motion.duration.slow}", "easing": "{motion.easing.decelerate}", "reducedMotion": "cross-fade only, per motion.reducedMotion" }
    },
    "toggle": {
      "$description": "v1.2. Prefer the platform's NATIVE switch/toggle control (Web <input type=checkbox role=switch>, Compose Switch, SwiftUI Toggle) styled to these tokens, over a custom-built control, so built-in accessibility semantics are inherited for free.",
      "$note": "v1.3 (product decision, ../product/USER_ROLES.md and Instructor Course Editor Publish/Unpublish): whenever a Toggle conveys a meaningful named state (e.g. Published/Draft), it MUST be paired with a visible text label showing that state's name -- never color or switch position alone. This is a usage rule, not a new visual token; the label uses standard typography.label.large next to the control.",
      "trackWidth": "{spacing.scale.space.10}", "trackHeight": "{spacing.scale.space.6}", "trackRadius": "{shape.radius.full}",
      "thumbSize": "{spacing.scale.space.5}", "thumbInset": "{border.width.focus}", "thumbTravel": "{spacing.scale.space.4}",
      "track": { "on": "{color.brand.primary}", "off": "{color.border.strong}", "disabled": "{color.border.default}@{state.disabledContainerOpacity}" },
      "thumb": { "color": "{color.surface.default}", "elevation": "{elevation.1}" },
      "focusRing": "{color.border.focus}"
    },
    "fileUpload": {
      "$description": "v1.2. Visual states only -- no upload/storage backend. For Instructor course thumbnails/videos/resources.",
      "radius": "{shape.radius.medium}", "padding": "{spacing.scale.space.6}",
      "idle": { "border": "{color.border.default}", "icon": "{color.text.secondary}", "text": "{color.text.secondary}", "browseAction": "component.button.tonal" },
      "dragOver": { "border": "{color.border.focus}", "background": "{color.brand.primaryContainer}" },
      "uploading": { "progress": "component.progressBar", "filenameTypography": "{typography.scale.body.medium}", "cancelAction": "component.button.icon" },
      "success": { "icon": "{color.success.default}", "filenameTypography": "{typography.scale.body.medium}", "metaTypography": "{typography.scale.caption}", "removeAction": "component.button.icon" },
      "error": { "border": "{color.border.error}", "icon": "{color.error.default}", "text": "{color.error.default}", "retryAction": "component.button.text" }
    },
    "reorderableList": {
      "$description": "v1.2. For Instructor sections/lessons. Drag-and-drop MUST ship with the nonDragControls as a fully equivalent alternative -- never drag-only.",
      "rowMinHeight": "{spacing.scale.space.12}", "paddingX": "{spacing.scale.space.4}", "gap": "{spacing.scale.space.3}",
      "background": "{color.surface.default}", "border": "{color.border.default}",
      "dragHandle": { "icon": "drag_indicator", "size": "{icon.medium}", "touchTarget": "{touchTarget.web_px}", "color": "{color.text.secondary}", "hoverColor": "{color.text.primary}" },
      "dragging": { "elevation": "{elevation.3}", "background": "{color.surface.elevated}" },
      "dropIndicator": { "color": "{color.brand.primary}", "height": "{border.width.focus}" },
      "nonDragControls": { "upAction": "component.button.icon", "downAction": "component.button.icon", "icons": { "up": "arrow_upward", "down": "arrow_downward" } }
    },
    "dataTable": {
      "$description": "v1.2. Web-primary (Instructor/Admin management). Responsive: collapses to stacked cards below the `tablet` breakpoint -- never a horizontally-cramped or force-scrolled desktop table on a narrow viewport.",
      "header": { "background": "{color.surface.variant}", "typography": "{typography.scale.label.medium}", "color": "{color.text.secondary}", "sortIcon": { "asc": "arrow_upward", "desc": "arrow_downward" } },
      "row": { "typography": "{typography.scale.body.medium}", "color": "{color.text.primary}", "border": "{color.border.default}", "hoverBackground": "{color.text.primary}@{state.hoverOpacity}" },
      "rowActions": { "trigger": "more_vert", "action": "component.button.icon" },
      "collapsedCard": { "radius": "{shape.radius.medium}", "background": "{color.surface.default}", "border": "{color.border.default}", "padding": "{spacing.scale.space.4}", "labelTypography": "{typography.scale.label.medium}", "valueTypography": "{typography.scale.body.medium}" },
      "pagination": { "action": "component.button.text", "label": "{typography.scale.body.small}" }
    },
    "select": {
      "$description": "v1.3. Dropdown / Select input. Field styling matches component.input exactly (same height/radius/padding/typography/border/background/text tokens) since it is visually an input variant; the menu it opens reuses the same popover/menu convention already established by videoPlayer.speedControl and dataTable.rowActions (elevation.3, surface.elevated, radius.medium) rather than inventing a new floating-surface pattern. Zero new colors introduced.",
      "height": 52, "radius": "{shape.radius.medium}", "paddingX": "{spacing.scale.space.4}",
      "typography": "{typography.scale.body.medium}", "labelTypography": "{typography.scale.label.medium}", "helperTypography": "{typography.scale.caption}",
      "leadingIconSize": "{icon.medium}",
      "trailingIcon": { "closed": "expand_more", "open": "expand_less" }, "trailingIconSize": "{icon.medium}",
      "border": { "default": "{color.border.default}", "hover": "{color.border.strong}", "focused": "{color.border.focus}", "open": "{color.border.focus}", "error": "{color.border.error}", "disabled": "{color.border.default}" },
      "background": { "default": "{color.surface.default}", "disabled": "{color.surface.variant}" },
      "text": { "default": "{color.text.primary}", "placeholder": "{color.text.disabled}", "disabled": "{color.text.disabled}", "error": "{color.error.default}" },
      "menu": { "elevation": "{elevation.3}", "background": "{color.surface.elevated}", "radius": "{shape.radius.medium}" },
      "option": {
        "height": "{touchTarget.web_px}", "paddingX": "{spacing.scale.space.4}", "typography": "{typography.scale.body.medium}",
        "text": { "default": "{color.text.primary}", "disabled": "{color.text.disabled}" },
        "background": { "default": "transparent", "hover": "{color.text.primary}@{state.hoverOpacity}", "selected": "{color.brand.primaryContainer}" },
        "selectedText": "{color.brand.onPrimaryContainer}"
      }
    }
  }
}
