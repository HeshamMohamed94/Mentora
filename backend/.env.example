# Mentora backend — local environment configuration.
# Copy this file to `.env` (same directory) and fill in real values. `.env` is gitignored; this
# example file is committed so the required/optional variables are documented and discoverable.
# Loaded by config/AppConfig.kt — a value already present in the real process environment always
# wins over `.env`, so `.env` is strictly a local-development convenience.

# --- Required (no default — the app fails fast at startup if this is missing/blank) ---

# A long, random signing secret for access/refresh JWTs. Generate one locally, e.g.:
#   openssl rand -base64 48
# Never reuse this value outside your own machine, and never commit a real one.
JWT_SIGNING_SECRET=

# --- Optional (sensible local defaults shown; override only if you need something different) ---

# MongoDB must be a replica set (even a single-node one) — this backend uses multi-document
# transactions (checkout, progress/certificate issuance, quiz submission) that a standalone
# MongoDB cannot run. See backend/README.md's "MongoDB setup" section for the one-time
# conversion steps if your local MongoDB is still standalone.
MONGODB_URI=mongodb://localhost:27017/mentora?replicaSet=rs0
MONGODB_DATABASE=mentora

JWT_ISSUER=mentora-backend
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Local filesystem root for uploaded media (thumbnails, avatars, lesson videos).
MEDIA_STORAGE_ROOT=storage/media

# Comma-separated list of allowed CORS origins (no client exists yet in Phase 1, but the plugin
# is already wired — this is the Web app's dev-server origin, per architecture/DEPLOYMENT.md § 4).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI Tutor provider (Phase 6 — see architecture/adr/ADR-009-ai-provider-abstraction.md and
# backend/README.md's "AI Tutor provider" section for the full account):
#   - AI_PROVIDER_API_KEY unset/blank  -> STUB mode. The AI Tutor endpoint is fully real (auth,
#     rate limits, persistence, enrollment gate) but replies with fixed placeholder text — no
#     network call, no cost, works completely offline. This is the safe default for local dev.
#   - AI_PROVIDER_API_KEY set          -> ANTHROPIC mode. Every AI Tutor message becomes a real,
#     billable call to the Anthropic Claude Messages API. Never commit a real key here — this file
#     is the *documented example*, `.env` (gitignored) is where a real key would actually go, and
#     even there, treat it as a real credential (see backend/README.md for cost/rate-limit notes).
# The active mode is always logged at startup ("AI Tutor provider mode: STUB" / "...ANTHROPIC...").
AI_PROVIDER_API_KEY=
# Must be a real, currently-valid Anthropic model id — an invalid one fails every AI Tutor message
# with a 500 (logged at ERROR with a "check AI_PROVIDER_MODEL" hint), not a silent fallback to stub.
AI_PROVIDER_MODEL=claude-sonnet-4-5
# Upper bound on one response's length passed to Anthropic as `max_tokens` — a cost control
# (architecture/AI_TUTOR_ARCHITECTURE.md § 6), not a UI truncation limit. Range: 1-8192.
AI_PROVIDER_MAX_RESPONSE_TOKENS=1024
# Absolute ceiling (seconds) on one AI Tutor message's provider round trip. Range: 5-600.
AI_PROVIDER_TIMEOUT_SECONDS=120

# Per-user AI Tutor rate limits (see architecture/AI_TUTOR_ARCHITECTURE.md § 6) — apply in both
# stub and Anthropic mode, so cost exposure from a single account stays bounded regardless of which
# provider is active.
AI_TUTOR_MESSAGES_PER_MINUTE=20
AI_TUTOR_MESSAGES_PER_DAY=200

LOG_LEVEL=DEBUG
