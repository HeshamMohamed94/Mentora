{
  "$description": "Platform-neutral normalization of design-system/design-tokens.json (v1.3.2) + design-system/themes/theme-{light,dark}.json. Values are copied, never re-derived or invented — this file is a faithful re-shape of the locked source, not a second independent token system. Consumers (shared/components.json, screens/*.json, patterns/*.json, and every per-platform generator) MUST reference tokens by their dot-path name (e.g. \"color.surface.default\") — never by a raw resolved value — so a future edit to design-tokens.json propagates without touching this file's structure.",
  "version": "1.3.2",
  "sourceReferences": [
    "design-system/design-tokens.json",
    "design-system/themes/theme-light.json",
    "design-system/themes/theme-dark.json"
  ],

  "units": {
    "source": "design-system/design-tokens.json#/units",
    "rule": "Typography tokens use the platform's scaling text unit (web rem / Android sp / iOS Dynamic-Type pt). Spacing, radius, elevation, icon, and border-width tokens use the platform's fixed layout unit (web px / Android dp / iOS pt) and never scale with text size.",
    "web": { "text": "rem (1rem = 16px root)", "layout": "px" },
    "android": { "text": "sp", "layout": "dp" },
    "ios": { "text": "pt via Dynamic Type", "layout": "pt" }
  },

  "color": {
    "$description": "Layer 1 (primitive, never consumed directly by product code) and layer 2 (semantic, the default consumption layer). Dot-path names below are exactly design-tokens.json's naming — e.g. this file's color.semantic.light[\"surface.default\"] is referenced elsewhere as \"color.surface.default\" with the active theme implicit.",
    "primitive": {
      "source": "design-system/design-tokens.json#/color/primitive",
      "note": "Raw palette (purple/indigo/accent/neutralLight/neutralDark/green/orange/red/blue). Never referenced directly outside design-tokens.json itself — copied here only so a cross-platform generator has the full palette available if a future component needs a literal-but-governed value (e.g. the course-artwork gradients, see shared/artwork.json).",
      "purple": { "50": "#F3F1FF", "100": "#E8E5FF", "200": "#C8C2FF", "300": "#A79FFF", "400": "#8B7FE8", "500": "#6558D3", "600": "#5548C2", "700": "#4A3EB0", "800": "#4E449E", "900": "#2B2170" },
      "indigo": { "50": "#E2E7FF", "200": "#BBC3FF", "500": "#4A62F0", "600": "#4058E0", "800": "#3B4278", "900": "#1C2470" },
      "accent": { "500": "#7C4DFF" },
      "neutralLight": { "0": "#FFFFFF", "50": "#F8F9FC", "75": "#F1F2F7", "100": "#F0F1F6", "200": "#E1E2E8", "300": "#8B8C96", "500": "#9A9BA3", "600": "#5F6069", "900": "#1A1B20" },
      "neutralDark": { "0": "#111217", "50": "#15161C", "100": "#191A20", "150": "#22232B", "200": "#24252E", "300": "#383941", "400": "#71727D", "500": "#777780", "600": "#C7C5CF", "900": "#F2F0F7" },
      "green": { "light": "#2E7D32", "lightContainer": "#E3F5E5", "dark": "#81C784", "darkContainer": "#1E4620" },
      "orange": { "light": "#ED8B00", "lightContainer": "#FFEDD6", "dark": "#FFB74D", "darkContainer": "#5C3D00" },
      "red": { "light": "#BA1A1A", "lightContainer": "#FFDAD6", "dark": "#FFB4AB", "darkContainer": "#93000A" },
      "blue": { "light": "#1976D2", "lightContainer": "#DCEBFC", "dark": "#90CAF9", "darkContainer": "#0D47A1" }
    },
    "semantic": {
      "source": "design-system/design-tokens.json#/color/semantic (+ themes/theme-{light,dark}.json, corroborating)",
      "note": "This is the layer every component/screen must reference by dot-path name — e.g. \"color.surface.default\", \"color.text.primary\". Values below resolve per theme; the NAME is theme-agnostic.",
      "light": {
        "background.primary": "#F8F9FC", "background.secondary": "#F1F2F7",
        "surface.default": "#FFFFFF", "surface.elevated": "#FFFFFF", "surface.variant": "#F0F1F6", "surface.inverse": "#1A1B20",
        "text.primary": "#1A1B20", "text.secondary": "#5F6069", "text.disabled": "#9A9BA3", "text.inverse": "#FFFFFF", "text.link": "#6558D3",
        "border.default": "#E1E2E8", "border.strong": "#8B8C96", "border.focus": "#6558D3", "border.error": "#BA1A1A",
        "brand.primary": "#6558D3", "brand.primaryHover": "#5548C2", "brand.primaryPressed": "#4A3EB0", "brand.primaryContainer": "#E8E5FF", "brand.onPrimary": "#FFFFFF", "brand.onPrimaryContainer": "#2B2170", "brand.onSurfaceInverse": "#C8C2FF",
        "secondary.default": "#4A62F0", "secondary.hover": "#4058E0", "secondary.container": "#E2E7FF", "secondary.onSecondary": "#FFFFFF", "secondary.onSecondaryContainer": "#1C2470",
        "accent.default": "#7C4DFF",
        "success.default": "#2E7D32", "success.container": "#E3F5E5", "success.onSuccess": "#FFFFFF", "success.onSuccessContainer": "#0D3312",
        "warning.default": "#ED8B00", "warning.container": "#FFEDD6", "warning.onWarning": "#3A2200", "warning.onWarningContainer": "#4A2C00",
        "error.default": "#BA1A1A", "error.container": "#FFDAD6", "error.onError": "#FFFFFF", "error.onErrorContainer": "#410002",
        "info.default": "#1976D2", "info.container": "#DCEBFC", "info.onInfo": "#FFFFFF", "info.onInfoContainer": "#0B2E4E",
        "overlay.scrim": "rgba(17,18,23,0.48)", "overlay.chipScrim": "rgba(17,18,23,0.72)"
      },
      "dark": {
        "background.primary": "#111217", "background.secondary": "#15161C",
        "surface.default": "#191A20", "surface.elevated": "#24252E", "surface.variant": "#22232B", "surface.inverse": "#F2F0F7",
        "text.primary": "#F2F0F7", "text.secondary": "#C7C5CF", "text.disabled": "#777780", "text.inverse": "#1A1B20", "text.link": "#C8C2FF",
        "border.default": "#383941", "border.strong": "#71727D", "border.focus": "#C8C2FF", "border.error": "#FFB4AB",
        "brand.primary": "#C8C2FF", "brand.primaryHover": "#B4AEEF", "brand.primaryPressed": "#A29BE0", "brand.primaryContainer": "#4E449E", "brand.onPrimary": "#2B2170", "brand.onPrimaryContainer": "#E8E5FF", "brand.onSurfaceInverse": "#6558D3",
        "secondary.default": "#BBC3FF", "secondary.hover": "#A7B0F5", "secondary.container": "#3B4278", "secondary.onSecondary": "#1C2470", "secondary.onSecondaryContainer": "#E2E7FF",
        "accent.default": "#B69CFF",
        "success.default": "#81C784", "success.container": "#1E4620", "success.onSuccess": "#0D3312", "success.onSuccessContainer": "#E3F5E5",
        "warning.default": "#FFB74D", "warning.container": "#5C3D00", "warning.onWarning": "#4A2C00", "warning.onWarningContainer": "#FFEDD6",
        "error.default": "#FFB4AB", "error.container": "#93000A", "error.onError": "#410002", "error.onErrorContainer": "#FFDAD6",
        "info.default": "#90CAF9", "info.container": "#0D47A1", "info.onInfo": "#0B2E4E", "info.onInfoContainer": "#DCEBFC",
        "overlay.scrim": "rgba(0,0,0,0.64)", "overlay.chipScrim": "rgba(17,18,23,0.72)"
      }
    },
    "state": {
      "source": "design-system/design-tokens.json#/color/semantic/{light,dark}/state.*",
      "light": { "hoverOpacity": 0.08, "pressedOpacity": 0.12, "focusOpacity": 0.12, "disabledContentOpacity": 0.38, "disabledContainerOpacity": 0.12 },
      "dark": { "hoverOpacity": 0.08, "pressedOpacity": 0.16, "focusOpacity": 0.16, "disabledContentOpacity": 0.38, "disabledContainerOpacity": 0.16 }
    }
  },

  "typographyRef": { "source": "design-to-code/shared/typography.json — split out per Step 4's requested file layout" },
  "spacingRef": { "source": "design-to-code/shared/spacing.json" },
  "shapeRef": { "source": "design-to-code/shared/shape.json" },
  "elevationRef": { "source": "design-to-code/shared/elevation.json" },

  "border": {
    "source": "design-system/design-tokens.json#/border",
    "width": { "default": 1, "focus": 2 }
  },

  "motion": {
    "source": "design-system/design-tokens.json#/motion",
    "duration": { "fast": 150, "normal": 200, "slow": 300 },
    "easing": { "standard": "cubic-bezier(0.4,0.0,0.2,1)", "decelerate": "cubic-bezier(0.0,0.0,0.2,1)", "accelerate": "cubic-bezier(0.4,0.0,1,1)" },
    "principle": "Motion communicates state change, never decoration. No bounce/spring/parallax without a functional reason.",
    "reducedMotion": "translate/scale/slide replaced by opacity cross-fade at duration.fast, or instant cut for sub-100ms feedback."
  },

  "icon": {
    "source": "design-system/design-tokens.json#/icon",
    "family": "Material Symbols Rounded",
    "sizes": { "small": 16, "medium": 20, "default": 24, "large": 32 },
    "directional": {
      "mirrorInRtl": ["chevron_left", "chevron_right", "arrow_back", "arrow_forward", "arrow_back_ios", "arrow_forward_ios", "trending_flat", "redo", "undo", "reply", "forward", "last_page", "first_page", "double_arrow", "menu_open"],
      "neverMirror": ["play_arrow", "pause", "check", "check_circle", "cancel", "close", "search", "add", "remove", "star", "favorite", "download", "upload", "expand_more", "expand_less", "refresh", "visibility", "visibility_off", "volume_up", "volume_off", "fullscreen", "fullscreen_exit", "speed", "cloud_upload", "insert_drive_file", "drag_indicator", "arrow_upward", "arrow_downward", "more_vert"]
    }
  },

  "breakpoints": {
    "source": "design-system/design-tokens.json#/breakpoints",
    "mobile": { "min": 0, "max": 599 },
    "tablet": { "min": 600, "max": 1023 },
    "desktop": { "min": 1024, "max": 1439 },
    "largeDesktop": { "min": 1440, "max": null }
  },

  "grid": {
    "source": "design-system/design-tokens.json#/grid",
    "columns": { "mobile": 4, "tablet": 8, "desktop": 12, "largeDesktop": 12 },
    "gutter": { "mobile": 16, "tablet": 24, "desktop": 24, "largeDesktop": 24 },
    "maxContentWidth": 1440,
    "preferredMarketingWidth": "1200-1280",
    "showcaseCorroboration": { "source": "design-review-locked/Mentora Showcase.dc.html", "extracted": "max-width:1280px found in showcase CSS, corroborating design-tokens.json's preferredMarketingWidth" }
  },

  "courseGrid": { "source": "design-system/design-tokens.json#/courseGrid", "mobile": 1, "tablet": 2, "desktop": 3, "largeDesktop": 4 },
  "avatar": { "source": "design-system/design-tokens.json#/avatar", "small": 24, "medium": 40, "large": 64, "xlarge": 96 },
  "touchTarget": { "source": "design-system/design-tokens.json#/touchTarget", "android_dp": 48, "ios_pt": 44, "web_px": 44 }
}
