# Local SDK path — machine-specific, never committed
local.properties

# Gradle
.gradle/
build/
**/build/
.kotlin/

# IntelliJ / Android Studio
.idea/
*.iml

# iOS / Kotlin Native framework outputs (built by Phase 5, on macOS only)
*.xcframework
DerivedData/
xcuserdata/
*.xcuserstate

# Phase 5 Task T1: explicit XCFramework output path, once `:shared:assembleSharedDebugXCFramework`/
# `:shared:assembleSharedReleaseXCFramework` actually run on a macOS host (Kotlin Multiplatform's
# documented XCFramework output convention: `<module>/build/XCFrameworks/<buildType>/`). Already
# covered by the blanket `**/build/` above — listed here anyway for the same belt-and-suspenders
# reason as the generic `*.xcframework`/`DerivedData/` entries above it, so the iOS build output is
# never accidentally committed regardless of where it ends up.
**/build/XCFrameworks/
**/DerivedData/

# OS
.DS_Store
Thumbs.db

# Ad-hoc local debug artifacts (screenshots/logs from manual repro work) — `.local-runtime/` above
# only matches the directory, not loose files like `.local-runtime-launch.png`.
.local-runtime-*
.shots/
